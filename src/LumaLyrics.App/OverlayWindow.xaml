<Window x:Class="LumaLyrics.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LumaLyrics.App"
 Title="浮光歌词 · 桌面歌词" Width="820" SizeToContent="Height" MinWidth="360" MinHeight="90" MaxHeight="640" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
 <Grid Background="Transparent" MouseLeftButtonDown="DragOverlay">
  <local:OverlaySurface x:Name="LyricSurface"/>
  <Popup x:Name="ToolbarPopup" Placement="Custom" PlacementTarget="{Binding ElementName=LyricSurface}" AllowsTransparency="True" StaysOpen="True" Focusable="False">
  <Border x:Name="Toolbar" CornerRadius="12" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" MouseEnter="ToolbarEntered" MouseLeave="ToolbarLeft">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="拖动移动" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,10,0"/>
    <ToggleButton x:Name="ChineseTranslationToggle" Content="中文译文" AutomationProperties.Name="悬浮歌词中文译文开关" ToolTip="开启或关闭悬浮歌词的中文译文" FontSize="11" Padding="9,3" Margin="0,0,3,0" Checked="TranslationToggled" Unchecked="TranslationToggled">
     <ToggleButton.Style><Style TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
       <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlBrush}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ToggleButton.Style>
    </ToggleButton>
    <Button Content="外观" FontSize="11" Padding="9,3" Margin="0,0,3,0" Click="AppearanceClicked"/>
    <Button Content="锁定" ToolTip="锁定并允许鼠标穿透；可从托盘解锁" FontSize="11" Padding="9,3" Margin="0,0,3,0" Click="LockClicked"/>
    <Button Content="主窗口" FontSize="11" Padding="9,3" Margin="0,0,3,0" Click="MainClicked"/>
    <Button Content="×" ToolTip="隐藏桌面歌词" FontSize="11" Padding="9,3" Margin="0" Click="HideClicked"/>
   </StackPanel>
  </Border>
  </Popup>
  <Popup x:Name="PlaybackPopup" Placement="Custom" PlacementTarget="{Binding ElementName=LyricSurface}" AllowsTransparency="True" StaysOpen="True" Focusable="False">
   <Border x:Name="PlaybackToolbar" CornerRadius="22" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5" MouseEnter="ToolbarEntered" MouseLeave="ToolbarLeft" KeyboardNavigation.TabNavigation="Cycle" DataContext="{Binding DataContext,ElementName=LyricSurface}">
    <Border.Resources>
     <Style x:Key="FloatingTransport" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
       <Grid Opacity="{Binding Path=(local:AppMotion.Availability),RelativeSource={RelativeSource TemplatedParent}}"><Border Background="{TemplateBinding Background}" CornerRadius="22"/>
        <Border x:Name="Feedback" CornerRadius="22" Background="{DynamicResource HoverBrush}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}"/>
        <Border CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" Opacity="{Binding Path=(local:AppMotion.Pressed),RelativeSource={RelativeSource TemplatedParent}}"/>
        <Border x:Name="FocusRing" CornerRadius="22" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Opacity="{Binding Path=(local:AppMotion.Focus),RelativeSource={RelativeSource TemplatedParent}}"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
      </ControlTemplate></Setter.Value></Setter>
     </Style>
    </Border.Resources>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="OverlayPrevious" Style="{StaticResource FloatingTransport}" Content="&#xE892;" IsEnabled="{Binding CanPrevious}" ToolTip="上一曲" AutomationProperties.Name="悬浮歌词上一曲" Tag="previous" Click="TransportClicked"/>
     <Button x:Name="OverlayPlayPause" Style="{StaticResource FloatingTransport}" Content="{Binding PlayGlyph}" IsEnabled="{Binding CanPlay}" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}" Tag="toggle" Click="TransportClicked" Margin="5,0"/>
     <Button x:Name="OverlayNext" Style="{StaticResource FloatingTransport}" Content="&#xE893;" IsEnabled="{Binding CanNext}" ToolTip="下一曲" AutomationProperties.Name="悬浮歌词下一曲" Tag="next" Click="TransportClicked"/>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</Window>
