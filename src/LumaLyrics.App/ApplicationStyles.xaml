<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LumaLyrics.App">
 <local:MotionFactorConverter x:Key="MotionFactor"/>
 <PopupAnimation x:Key="AppPopupAnimation">Fade</PopupAnimation>

 <!-- State layers animate independently of palette brushes, so a cover/theme update never erases feedback. -->
 <ControlTemplate x:Key="AppActionTemplate" TargetType="ButtonBase">
  <Grid Background="Transparent" Opacity="{Binding Path=(local:AppMotion.Availability),RelativeSource={RelativeSource TemplatedParent}}"><Grid x:Name="InteractionVisual">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Path=(local:AppMotion.CornerRadius),RelativeSource={RelativeSource TemplatedParent}}"/>
   <Border x:Name="SelectionSurface" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{Binding Path=(local:AppMotion.CornerRadius),RelativeSource={RelativeSource TemplatedParent}}" Opacity="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"/>
   <Border x:Name="HoverSurface" Background="{Binding Path=(local:AppMotion.FeedbackBrush),RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="{Binding Path=(local:AppMotion.CornerRadius),RelativeSource={RelativeSource TemplatedParent}}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"/>
   <Border Background="{DynamicResource PressedBrush}" CornerRadius="{Binding Path=(local:AppMotion.CornerRadius),RelativeSource={RelativeSource TemplatedParent}}" Opacity="{Binding Path=(local:AppMotion.Pressed),RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"/>
   <Border x:Name="FocusSurface" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{Binding Path=(local:AppMotion.CornerRadius),RelativeSource={RelativeSource TemplatedParent}}" Opacity="{Binding Path=(local:AppMotion.Focus),RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"/>
   <Border Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border>
  </Grid></Grid>
 </ControlTemplate>
 <Style x:Key="AppAction" TargetType="ButtonBase">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="local:AppMotion.CornerRadius" Value="{DynamicResource ControlRadius}"/><Setter Property="local:AppMotion.FeedbackBrush" Value="{DynamicResource HoverBrush}"/><Setter Property="Template" Value="{StaticResource AppActionTemplate}"/>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource AppAction}"/>
 <Style TargetType="ToggleButton" BasedOn="{StaticResource AppAction}"/>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="local:AppMotion.FeedbackBrush" Value="{DynamicResource PrimaryFeedbackBrush}"/>
 </Style>
 <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
 <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="18"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
 <Style x:Key="QueueVisibilityToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0"/></Style>
 <Style x:Key="ThemeChoice" TargetType="RadioButton" BasedOn="{StaticResource AppAction}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Padding" Value="14"/></Style>
 <Style x:Key="AlbumCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="local:AppMotion.CornerRadius" Value="{DynamicResource CardRadius}"/></Style>
 <Style x:Key="AlbumPlayButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="local:AppMotion.CornerRadius" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>

 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,10"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid>
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource InputRadius}"/>
   <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" CornerRadius="{DynamicResource InputRadius}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource MotionFactor},ConverterParameter=.45}" IsHitTestVisible="False"/>
   <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource InputRadius}" Opacity="{Binding Path=(local:AppMotion.Focus),RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"/>
   <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="MinHeight" Value="38"/><Setter Property="MaxDropDownHeight" Value="280"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource InputRadius}"/>
   <Border Background="{DynamicResource HoverBrush}" CornerRadius="{DynamicResource InputRadius}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}"/>
   <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource InputRadius}" Opacity="{Binding Path=(local:AppMotion.Focus),RelativeSource={RelativeSource TemplatedParent}}"/>
   <ToggleButton x:Name="Toggle" local:AppMotion.Enabled="False" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Margin="13,10,34,10" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="{DynamicResource AppPopupAnimation}"><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="11,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template" Value="{DynamicResource AppListItemTemplate}"/></Style>

 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21"/></DataTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Opacity="{Binding Path=(local:AppMotion.Availability),RelativeSource={RelativeSource TemplatedParent}}"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Height="22" VerticalAlignment="Center"><Border CornerRadius="11" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
    <Border CornerRadius="11" Background="{DynamicResource AccentBrush}" Opacity="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent}}"/>
    <Border CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Margin="-3" Opacity="{Binding Path=(local:AppMotion.Focus),RelativeSource={RelativeSource TemplatedParent}}"/>
    <Border CornerRadius="11" Background="{DynamicResource PrimaryFeedbackBrush}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}"/>
    <Grid x:Name="SwitchKnob" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"><Grid.RenderTransform><TranslateTransform X="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource MotionFactor},ConverterParameter=16}"/></Grid.RenderTransform><Ellipse Fill="{DynamicResource SwitchKnobBrush}"/><Ellipse Fill="{DynamicResource AccentTextBrush}" Opacity="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent}}"/></Grid>
   </Grid><ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 <ControlTemplate x:Key="AppListItemTemplate" TargetType="ListBoxItem"><Grid>
  <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ItemRadius}"/>
  <Border Background="{DynamicResource HoverBrush}" CornerRadius="{DynamicResource ItemRadius}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}"/>
  <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource ItemRadius}" Opacity="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent}}"/>
  <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource ItemRadius}" Opacity="{Binding Path=(local:AppMotion.Focus),RelativeSource={RelativeSource TemplatedParent}}"/>
  <Border Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
 </Grid></ControlTemplate>
 <Style TargetType="ListBoxItem"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template" Value="{StaticResource AppListItemTemplate}"/></Style>
 <Style x:Key="ThemeItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"/>

 <Style TargetType="TabControl"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="TabStripPlacement" Value="Left"/>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="146"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource RailBrush}" Margin="0,0,16,0" Padding="7,10"><ItemsPresenter KeyboardNavigation.TabIndex="1"/></Border>
   <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="22,24"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.FontWeight="Normal" local:AppMotion.RevealOnChange="True" KeyboardNavigation.TabIndex="2"/></Border>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid>
   <Border Background="{DynamicResource HoverBrush}" CornerRadius="{DynamicResource ControlRadius}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}"/>
   <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource ControlRadius}" Opacity="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent}}"/>
   <Border Width="3" Height="16" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent}}"/>
   <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Opacity="{Binding Path=(local:AppMotion.Focus),RelativeSource={RelativeSource TemplatedParent}}"/>
   <Border Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="DataGridRow"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Grid Background="{TemplateBinding Background}"><Border Background="{DynamicResource HoverBrush}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}"/><Border Background="{DynamicResource AccentSoftBrush}" Opacity="{Binding Path=(local:AppMotion.Selected),RelativeSource={RelativeSource TemplatedParent}}"/><DataGridCellsPresenter/></Grid></ControlTemplate></Setter.Value></Setter></Style>

 <Style x:Key="AppTrackBar" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="local:AppMotion.Enabled" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Slider"><Setter Property="MinHeight" Value="26"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Focusable" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="1,0"><Border x:Name="FocusRing" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Margin="-4,1"/>
   <Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource AppTrackBar}" Background="{DynamicResource AccentBrush}"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource AppTrackBar}" Background="{DynamicResource ControlBrush}"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb x:Name="Handle" Width="12" Height="12" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="MinWidth" Value="9"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
   <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" local:AppMotion.Enabled="False"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" local:AppMotion.Enabled="False"/></Track.IncreaseRepeatButton>
   <Track.Thumb><Thumb x:Name="ScrollThumb" MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Margin="2,0"><Border CornerRadius="3" Background="{DynamicResource ScrollThumbBrush}" Opacity=".65"/><Border CornerRadius="3" Background="{DynamicResource AccentBrush}" Opacity="{Binding Path=(local:AppMotion.Hover),RelativeSource={RelativeSource TemplatedParent}}"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
  </Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/><Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/><Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="9"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/><Border x:Name="Pulse" Width="90" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform></Border></Grid><ControlTemplate.Triggers>
  <Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Pulse" Property="Visibility" Value="Visible"/></Trigger>
  <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsIndeterminate" Value="True"/><Condition Property="IsVisible" Value="True"/><Condition Property="local:AppMotion.AnimationsEnabled" Value="True"/></MultiTrigger.Conditions><MultiTrigger.EnterActions><BeginStoryboard x:Name="ProgressPulse"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-90" To="700" Duration="0:0:1.8"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions><MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ProgressPulse"/></MultiTrigger.ExitActions></MultiTrigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
