<Window x:Class="LumaLyrics.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="浮光歌词 LumaLyrics" Width="1060" Height="720" MinWidth="760" MinHeight="520" Background="#101216" Foreground="#F5F7FA" FontFamily="Segoe UI Variable, Microsoft YaHei UI" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
 <Grid Margin="28,20,28,18" Background="#101216">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,24"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="◒" FontSize="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><StackPanel><TextBlock Text="浮光歌词" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="L U M A L Y R I C S" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="{Binding LibraryLabel}" ToolTip="{Binding Library}" Click="LibraryClicked"/><Button Content="桌面歌词" Click="ToggleOverlayClicked"/><Button Content="外观" Click="AppearanceClicked"/><Button Content="设置" Click="SettingsClicked"/><Button Content="诊断" Click="DiagnosticsClicked" Margin="0"/></StackPanel></DockPanel>
  <Grid x:Name="Body" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="InfoColumn" Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="InfoRow" Height="*"/><RowDefinition x:Name="LyricsRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="InfoPanel" Margin="0,0,28,0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="ArtworkBorder" MaxHeight="270" CornerRadius="20" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#46405E"/><GradientStop Color="#1B2932" Offset="1"/></LinearGradientBrush></Border.Background><Grid><TextBlock x:Name="CoverPlaceholder" Text="♫" FontSize="104" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Artwork" Stretch="UniformToFill"/></Grid></Border>
    <TextBlock x:Name="TrackTitle" Grid.Row="1" Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="104" TextTrimming="CharacterEllipsis" Margin="0,18,0,8"/>
    <TextBlock x:Name="TrackArtist" Grid.Row="2" Text="{Binding Artist}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" LineHeight="20"/>
    <TextBlock x:Name="TrackTime" Grid.Row="3" Text="{Binding Time}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6"/>
    <Slider Grid.Row="4" x:Name="SeekSlider" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position,Mode=OneWay}" IsEnabled="{Binding CanSeek}" ToolTip="{Binding Time}" AutomationProperties.Name="播放进度" PreviewMouseLeftButtonUp="SeekReleased"/>
    <StackPanel x:Name="PlaybackControls" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,14"><Button Content="◀" ToolTip="上一首" IsEnabled="{Binding CanPrevious}" Click="PreviousClicked"/><Button x:Name="PlayButton" Content="播放 / 暂停" IsEnabled="{Binding CanPlay}" Click="PlayClicked"/><Button Content="▶" ToolTip="下一首" IsEnabled="{Binding CanNext}" Click="NextClicked" Margin="0"/></StackPanel>
    <TextBlock Grid.Row="6" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/><TextBlock Grid.Row="7" Text="{Binding Quality}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
   </Grid>
   <Border x:Name="LyricsPanel" Grid.Column="1" CornerRadius="18" Background="#15181E" Padding="24,10">
    <Grid><ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ManualScroll" ScrollChanged="LyricsScrollChanged"><StackPanel x:Name="LyricLines" Margin="0,90,10,110"/></ScrollViewer>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390"><TextBlock Text="每一句，都有回响。" FontSize="27" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="在 Apple Music 中播放歌曲，歌词将在这里展开。也可以拖入本地 LRC / TXT。" FontSize="14" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,22"/><Button Content="导入本地歌词" Click="ImportClicked" HorizontalAlignment="Center"/></StackPanel>
     <Button x:Name="ReturnButton" Content="回到当前歌词 ↓" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="ReturnClicked" Margin="0,0,0,8"/>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="提前 0.1 秒" Click="EarlierClicked" Padding="10,8"/><Button Content="延后 0.1 秒" Click="LaterClicked" Padding="10,8"/><Button Content="重置" Click="ResetOffsetClicked" Padding="10,8"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="更换歌词" Click="CandidatesClicked"/><Button Content="导入" Click="ImportClicked"/><Button Content="重新搜索" Click="RetryClicked" Margin="0"/></StackPanel></DockPanel><DockPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock Text="{Binding Offset}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding LyricStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/></DockPanel></Grid>
 </Grid>
</Window>
