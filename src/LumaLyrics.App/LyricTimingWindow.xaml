<Window x:Class="LumaLyrics.App.LyricTimingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LumaLyrics.App"
 Title="{local:Loc Text='制作动态歌词'}" Width="960" Height="720" MinWidth="680" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <Style x:Key="TimingCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
   <Setter Property="Padding" Value="17"/>
  </Style>
  <Style x:Key="TimingCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </Window.Resources>
 <Grid x:Name="Editor" Margin="22,18,22,16" Focusable="True" KeyboardNavigation.TabNavigation="Continue">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="{local:Loc Text='制作动态歌词'}" Style="{StaticResource AppDialogHeadline}"/>
   <TextBlock x:Name="RecordingLabel" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource TimingCard}" Padding="14,9" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="PlaybackTime" FontFamily="Consolas" FontSize="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" MinWidth="126"/>
    <TextBlock x:Name="PlaybackStatus" Grid.Column="1" Style="{StaticResource TimingCaption}" VerticalAlignment="Center"/>
    <TextBlock x:Name="CountLabel" Grid.Column="2" Style="{StaticResource TimingCaption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.22*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource TimingCard}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="LyricsHeading" Text="{local:Loc Text='静态原词'}" FontSize="16" FontWeight="SemiBold"/>
      <Button x:Name="LoadText" Grid.Column="1" Content="{local:Loc Text='打开文本…'}" Click="LoadTextClicked" Padding="8,3" MinHeight="26"/>
     </Grid>
     <TextBox x:Name="SourceText" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="131072" VerticalContentAlignment="Top"
      VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Loc Text='静态原词'}"/>
     <ListBox x:Name="TimedLines" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LineSelectionChanged" AutomationProperties.Name="{local:Loc Text='逐行时间轴'}">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Number}" Style="{StaticResource TimingCaption}" FontFamily="Consolas" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1">
         <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
         <TextBlock Text="{Binding Times}" Style="{StaticResource TimingCaption}" FontFamily="Consolas" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding Gap}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Gap}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource TimingCard}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
     <StackPanel>
      <TextBlock x:Name="Step" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="FeaturedLine" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"
       Foreground="{DynamicResource TextBrush}" Margin="0,8,0,10"/>
      <TextBlock x:Name="Instruction" Style="{StaticResource TimingCaption}" Margin="0,0,0,8"/>
      <WrapPanel x:Name="MarkActions" Visibility="Collapsed" Margin="0,4,0,8">
       <Button x:Name="MarkLine" Style="{StaticResource PrimaryButton}" Click="MarkClicked" Margin="0,0,7,6"/>
       <Button x:Name="InsertGap" Content="{local:Loc Text='G · 在上一句后插入间奏'}" Click="GapClicked" Margin="0,0,7,6"/>
       <Button x:Name="UndoMark" Content="{local:Loc Text='撤销'}" Click="UndoClicked" Margin="0,0,7,6"/>
      </WrapPanel>
      <ProgressBar x:Name="Completion" Height="4" Visibility="Collapsed" Margin="0,0,0,14"/>
      <StackPanel x:Name="Review" Visibility="Collapsed">
       <TextBlock Text="{local:Loc Text='校对所选句'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="{local:Loc Text='开始时间'}" Style="{StaticResource TimingCaption}" Margin="0,0,0,3"/>
         <TextBox x:Name="EditStart" FontFamily="Consolas" Padding="8,6" AutomationProperties.Name="{local:Loc Text='开始时间'}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="{local:Loc Text='结束时间'}" Style="{StaticResource TimingCaption}" Margin="0,0,0,3"/>
         <TextBox x:Name="EditEnd" FontFamily="Consolas" Padding="8,6" AutomationProperties.Name="{local:Loc Text='结束时间'}"/>
        </StackPanel>
       </Grid>
       <Button x:Name="ApplyTimes" Content="{local:Loc Text='应用时间'}" Click="EditClicked" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Feedback" Style="{StaticResource TimingCaption}" MaxHeight="62" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="BeginTiming" Content="{local:Loc Text='开始打轴'}" Style="{StaticResource PrimaryButton}" Click="BeginClicked" Margin="0,0,8,0"/>
    <Button x:Name="SaveTiming" Content="{local:Loc Text='保存动态歌词'}" Style="{StaticResource PrimaryButton}" Click="SaveClicked" Visibility="Collapsed" Margin="0,0,8,0"/>
    <Button Content="{local:Loc Text='关闭'}" Click="CloseClicked"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
